{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guandan",
  "compatibility_date": "2026-08-25",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "guandan.mapin.net",
      "custom_domain": true
    }
  ]
}
